<Window x:Class="Jot.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jot tray menu" Width="212" SizeToContent="Height" ShowActivated="False"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="False"
        UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnKeyDown" Deactivated="OnDeactivated">
  <Window.Resources>
    <SolidColorBrush x:Key="TraySurface" Color="#262626"/>
    <SolidColorBrush x:Key="TrayText" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="TrayMuted" Color="#A3A3A3"/>
    <SolidColorBrush x:Key="TrayBorder" Color="#42808080"/>
    <SolidColorBrush x:Key="TrayHover" Color="#3B3B3B"/>
    <SolidColorBrush x:Key="TrayFocus" Color="#A3A3A3"/>
    <Style x:Key="TrayActionStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TrayText}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="HitArea" Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HitArea" Property="Background" Value="{DynamicResource TrayHover}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="HitArea" Property="Background" Value="{DynamicResource TrayHover}"/>
                <Setter TargetName="HitArea" Property="BorderBrush" Value="{DynamicResource TrayFocus}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HitArea" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="TrayRoot" Focusable="True" FocusVisualStyle="{x:Null}"><Border x:Name="MenuSurface" Margin="6" Padding="4" CornerRadius="5" BorderThickness="1"
          Background="{DynamicResource TraySurface}" BorderBrush="{DynamicResource TrayBorder}">
    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.18"/></Border.Effect>
    <StackPanel>
      <Grid Height="30" Margin="8,0,8,2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image x:Name="BrandIcon" Width="17" Height="17" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Jot" Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource TrayText}" VerticalAlignment="Center"/>
        <Path x:Name="ProgressRing" Grid.Column="2" Width="16" Height="16" Visibility="Collapsed"
              Stroke="{DynamicResource TrayText}" StrokeThickness="1.8" StrokeDashArray="12 6">
          <Path.Data><EllipseGeometry Center="8,8" RadiusX="5.5" RadiusY="5.5"/></Path.Data>
          <Path.RenderTransform><RotateTransform CenterX="8" CenterY="8"/></Path.RenderTransform>
        </Path>
      </Grid>
      <StackPanel x:Name="Actions"/>
      <TextBlock x:Name="MenuError" Visibility="Collapsed" Foreground="#EF7770" TextWrapping="Wrap" FontSize="12" Margin="10,8,10,7"/>
    </StackPanel>
  </Border></Grid>
</Window>
