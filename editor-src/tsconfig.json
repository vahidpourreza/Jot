{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
    ,"paths": {
      "@editorcn/block-editor": ["../node_modules/@editorcn/block-editor/src/index.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
