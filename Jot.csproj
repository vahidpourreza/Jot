<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jot</AssemblyName>
    <RootNamespace>Jot</RootNamespace>
    <Version>1.6.0</Version>
    <ApplicationIcon>assets\jot.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JotOfflinePackage)' == 'true'">
    <DefineConstants>$(DefineConstants);JOT_OFFLINE_PACKAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="artifacts\**;test-results\**;recovery\**;dist\**" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="styles.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="renderer.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="bidi.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="editor-menu.js;tests\context-tests.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="context-menus.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="home.html;home.js;image.html;image.js;shared.js;design-tokens.js;workspace.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="library.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="workspace-tabs.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="workspace-editor.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="writing-settings.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="workspace.html;workspace.js;workspace-shell.css;workspace-tab-actions.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="notes-files.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="document-heading.js;writing-tools.js;document-note.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="note-text-size.js;document-blocks.js;document-blocks.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tab-switcher.js;tab-switcher.css" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="assets\emoji\emoji-values.txt" LogicalName="Jot.EmojiValues" />
    <Content Include="notifications.js;notifications.css;shortcut-bindings.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="browser-tabs.css;tab-colors.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="note-personalization.js;note-personalization.css;file-state.css;shortcuts.html;shortcuts.js;shortcuts.css;app-shortcuts.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="i18n.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="settings.html;settings.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tests\renderer-tests.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tests\bidi-tests.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
